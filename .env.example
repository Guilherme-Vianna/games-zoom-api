# ==== games-zoom-api ====

# Neon Postgres — COM "-pooler" (runtime da app)
DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# SEM "-pooler" (so migrations — advisory locks nao passam pelo pooler)
DIRECT_URL="postgresql://USER:PASS@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# openssl rand -base64 32
API_JWT_SECRET="troque-por-um-segredo-aleatorio"

# URL do frontend. Local: http://localhost:3000 | Prod: https://games-zoom-ui.vercel.app
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"

# E-mail: "console" (dev, loga o link) | "sendpulse" (envia)
EMAIL_TRANSPORT="console"
SENDPULSE_SENDER_EMAIL="no-reply@seu-dominio.com"
SENDPULSE_SENDER_NAME="Games Zoom"
SENDPULSE_API_KEY=""
SENDPULSE_CLIENT_ID=""
SENDPULSE_CLIENT_SECRET=""
